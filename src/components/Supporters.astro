import { supporters } from '@data/supporters';
---

<section class="bg-white py-16">
    <div class="container mx-auto px-4">
        <div class="max-w-5xl mx-auto">
            <h2 class="text-3xl font-bold text-center mb-12 content-text">Our Supporters</h2>
            <p class="text-center text-lg mb-8 text-gray-600">
                We're grateful for the support of these organizations helping us build a sustainable community
            </p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 items-center">
                {supporters.map(supporter => (
                    <div class="supporter-logo">
                        {supporter.link ? (
                            <a href={supporter.link} target="_blank" rel="noopener noreferrer">
                                <img
                                    src={supporter.logo}
                                    alt={supporter.name}
                                    class="clickable-image"
                                    onerror={`this.parentElement.innerHTML='<div class="text-center text-sm font-semibold">${supporter.name}</div>';`}
                                >
                            </a>
                        ) : (
                            <img
                                src={supporter.logo}
                                alt={supporter.name}
                                class="clickable-image"
                                onerror={`this.parentElement.innerHTML='<div class="text-center text-sm font-semibold">${supporter.name}</div>';`}
                            >
                        )}
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

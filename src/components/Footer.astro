<footer class="footer-bg py-12">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
            <div class="grid md:grid-cols-3 gap-8 mb-8">
                <div>
                    <h3 class="text-xl font-bold mb-4 footer-text">Basingstoke Repair Network</h3>
                    <p class="footer-text">Building sustainable communities through repair and reuse</p>
                </div>
                <div>

---
import { getEntry } from 'astro:content';
import Countdown from './Countdown.astro';

export interface Props {
  eventType: 'chineham' | 'hatch-warren';
  className?: string;
  // All other props will be loaded from CMS and can be overridden
  title?: string;
  eventDuration?: number;
  eventTime?: string;
  skipDecember?: boolean;
  beforeEventText?: string;
  duringEventText?: string;
}

const { eventType, className, ...overrides } = Astro.props;

// Load settings from CMS
const settings = await getEntry('settings', 'countdown');
const eventSettings = settings.data[eventType];

// Merge CMS settings with any overrides
const finalProps = {
  eventType,
  className,
  title: overrides.title ?? eventSettings.title,
  eventDuration: overrides.eventDuration ?? eventSettings.eventDuration,
  eventTime: overrides.eventTime ?? eventSettings.eventTime,
  skipDecember: overrides.skipDecember ?? eventSettings.skipDecember,
  beforeEventText: overrides.beforeEventText ?? eventSettings.beforeEventText,
  duringEventText: overrides.duringEventText ?? eventSettings.duringEventText,
};
---

<Countdown {...finalProps} />
---
export interface Props {
  googleDriveFolderId?: string; // Google Drive folder ID from share link
  googlePhotosAlbumId?: string; // Google Photos album ID (requires API key)
  apiKey?: string; // Google API key for Photos API
  title?: string;
  className?: string;
  columns?: number; // Number of columns in grid (default: auto-responsive)
  maxImages?: number; // Limit number of images shown
  showTitles?: boolean; // Show image titles/descriptions
}

const { 
  googleDriveFolderId,
  googlePhotosAlbumId, 
  apiKey,
  title = "Photo Gallery",
  className = "",
  columns = 0, // 0 = auto-responsive
  maxImages = 50,
  showTitles = false
} = Astro.props;

// Validate required props
if (!googleDriveFolderId && !googlePhotosAlbumId) {
  throw new Error("PhotoGallery requires either googleDriveFolderId or googlePhotosAlbumId");
}

if (googlePhotosAlbumId && !apiKey) {
  throw new Error("PhotoGallery with Google Photos requires an apiKey");
}
---

<div class={`photo-gallery ${className}`} 
     data-drive-folder={googleDriveFolderId} 
     data-photos-album={googlePhotosAlbumId}
     data-api-key={apiKey}
     data-max-images={maxImages}
     data-show-titles={showTitles}
     data-columns={columns}>
  
  <div class="gallery-header">
    <h3 class="gallery-title">{title}</h3>
    <div class="gallery-loading">
      <div class="loading-spinner"></div>
      <span>Loading photos...</span>
    </div>
  </div>
  
  <div class="gallery-grid">
    <!-- Photos will be loaded here dynamically -->
  </div>
  
  <div class="gallery-error" style="display: none;">
    <p>Unable to load photos. Please check the sharing settings.</p>
  </div>
</div>

<!-- Lightbox Modal -->
<div class="lightbox-overlay" style="display: none;">
  <div class="lightbox-container">
    <button class="lightbox-close" aria-label="Close">&times;</button>
    <button class="lightbox-prev" aria-label="Previous">‹</button>
    <button class="lightbox-next" aria-label="Next">›</button>
    <img class="lightbox-image" src="" alt="" />
    <div class="lightbox-caption"></div>
    <div class="lightbox-counter"></div>
  </div>
</div>

<style>
  .photo-gallery {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem;
  }

  .gallery-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .gallery-title {
    margin: 0 0 1rem 0;
    color: #2d3748;
    font-size: 1.875rem;
    font-weight: 600;
  }

  .gallery-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #718096;
  }

  .loading-spinner {
    width: 20px;
    height: 20px;
    border: 2px solid #e2e8f0;
    border-top: 2px solid #4299e1;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .gallery-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  }

  .gallery-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
  .gallery-grid.columns-3 { grid-template-columns: repeat(3, 1fr); }
  .gallery-grid.columns-4 { grid-template-columns: repeat(4, 1fr); }
  .gallery-grid.columns-5 { grid-template-columns: repeat(5, 1fr); }

  .gallery-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    background: #f7fafc;
  }

  .gallery-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  .gallery-item-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: white;
    padding: 1rem 0.75rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .gallery-error {
    text-align: center;
    padding: 2rem;
    color: #e53e3e;
    background: #fed7d7;
    border-radius: 0.5rem;
    margin-top: 1rem;
  }

  /* Lightbox Styles */
  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-container {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 0.5rem;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    color: #2d3748;
    font-size: 2rem;
    font-weight: bold;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 1);
  }

  .lightbox-close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox-prev {
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-caption {
    color: white;
    text-align: center;
    margin-top: 1rem;
    font-size: 1rem;
    max-width: 80vw;
  }

  .lightbox-counter {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 0.5rem;
    }

    .gallery-grid.columns-2 { grid-template-columns: repeat(2, 1fr); }
    .gallery-grid.columns-3 { grid-template-columns: repeat(2, 1fr); }
    .gallery-grid.columns-4 { grid-template-columns: repeat(2, 1fr); }
    .gallery-grid.columns-5 { grid-template-columns: repeat(3, 1fr); }

    .lightbox-prev,
    .lightbox-next {
      width: 40px;
      height: 40px;
      font-size: 1.5rem;
    }
  }
</style>

<script>
  class PhotoGallery {
    constructor(container) {
      this.container = container;
      this.driveFolderId = container.dataset.driveFolder;
      this.photosAlbumId = container.dataset.photosAlbum;
      this.apiKey = container.dataset.apiKey;
      this.maxImages = parseInt(container.dataset.maxImages) || 50;
      this.showTitles = container.dataset.showTitles === 'true';
      this.columns = parseInt(container.dataset.columns) || 0;
      
      this.photos = [];
      this.currentIndex = 0;
      
      this.grid = container.querySelector('.gallery-grid');
      this.loading = container.querySelector('.gallery-loading');
      this.error = container.querySelector('.gallery-error');
      
      this.lightbox = document.querySelector('.lightbox-overlay');
      this.lightboxImage = document.querySelector('.lightbox-image');
      this.lightboxCaption = document.querySelector('.lightbox-caption');
      this.lightboxCounter = document.querySelector('.lightbox-counter');
      
      this.init();
    }
    
    async init() {
      try {
        if (this.columns > 0) {
          this.grid.className = `gallery-grid columns-${this.columns}`;
        }
        
        if (this.driveFolderId) {
          await this.loadGoogleDrivePhotos();
        } else if (this.photosAlbumId) {
          await this.loadGooglePhotos();
        }
        
        this.setupLightbox();
        this.hideLoading();
      } catch (error) {
        console.error('Error loading photos:', error);
        this.showError();
      }
    }
    
    async loadGoogleDrivePhotos() {
      // Google Drive API endpoint for public folders
      const url = `https://www.googleapis.com/drive/v3/files?q='${this.driveFolderId}'+in+parents+and+mimeType+contains+'image'&key=${this.apiKey}&fields=files(id,name,thumbnailLink,webContentLink)`;
      
      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Failed to fetch photos');
        
        const data = await response.json();
        
        this.photos = data.files.slice(0, this.maxImages).map(file => ({
          id: file.id,
          title: file.name,
          thumbnail: file.thumbnailLink,
          fullSize: `https://drive.google.com/uc?id=${file.id}`,
          webLink: file.webContentLink
        }));
        
        this.renderPhotos();
      } catch (error) {
        // Fallback: Try to parse public sharing link manually
        console.warn('API call failed, attempting manual parsing');
        this.showError();
      }
    }
    
    async loadGooglePhotos() {
      // Google Photos API endpoint
      const url = `https://photoslibrary.googleapis.com/v1/albums/${this.photosAlbumId}:search`;
      
      try {
        const response = await fetch(url, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${this.apiKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            pageSize: this.maxImages,
            albumId: this.photosAlbumId
          })
        });
        
        if (!response.ok) throw new Error('Failed to fetch photos');
        
        const data = await response.json();
        
        this.photos = data.mediaItems.map(item => ({
          id: item.id,
          title: item.filename,
          thumbnail: `${item.baseUrl}=w300-h300-c`,
          fullSize: `${item.baseUrl}=w1920-h1080`,
          webLink: item.productUrl
        }));
        
        this.renderPhotos();
      } catch (error) {
        console.error('Google Photos API error:', error);
        this.showError();
      }
    }
    
    renderPhotos() {
      this.grid.innerHTML = '';
      
      this.photos.forEach((photo, index) => {
        const item = document.createElement('div');
        item.className = 'gallery-item';
        item.dataset.index = index;
        
        const img = document.createElement('img');
        img.src = photo.thumbnail;
        img.alt = photo.title;
        img.loading = 'lazy';
        
        item.appendChild(img);
        
        if (this.showTitles && photo.title) {
          const title = document.createElement('div');
          title.className = 'gallery-item-title';
          title.textContent = photo.title;
          item.appendChild(title);
        }
        
        item.addEventListener('click', () => this.openLightbox(index));
        this.grid.appendChild(item);
      });
    }
    
    setupLightbox() {
      const closeBtn = document.querySelector('.lightbox-close');
      const prevBtn = document.querySelector('.lightbox-prev');
      const nextBtn = document.querySelector('.lightbox-next');
      
      closeBtn.addEventListener('click', () => this.closeLightbox());
      prevBtn.addEventListener('click', () => this.showPrevious());
      nextBtn.addEventListener('click', () => this.showNext());
      
      this.lightbox.addEventListener('click', (e) => {
        if (e.target === this.lightbox) this.closeLightbox();
      });
      
      document.addEventListener('keydown', (e) => {
        if (this.lightbox.style.display !== 'none') {
          if (e.key === 'Escape') this.closeLightbox();
          if (e.key === 'ArrowLeft') this.showPrevious();
          if (e.key === 'ArrowRight') this.showNext();
        }
      });
    }
    
    openLightbox(index) {
      this.currentIndex = index;
      this.showLightboxImage();
      this.lightbox.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
    
    closeLightbox() {
      this.lightbox.style.display = 'none';
      document.body.style.overflow = '';
    }
    
    showPrevious() {
      this.currentIndex = (this.currentIndex - 1 + this.photos.length) % this.photos.length;
      this.showLightboxImage();
    }
    
    showNext() {
      this.currentIndex = (this.currentIndex + 1) % this.photos.length;
      this.showLightboxImage();
    }
    
    showLightboxImage() {
      const photo = this.photos[this.currentIndex];
      this.lightboxImage.src = photo.fullSize;
      this.lightboxImage.alt = photo.title;
      this.lightboxCaption.textContent = photo.title || '';
      this.lightboxCounter.textContent = `${this.currentIndex + 1} / ${this.photos.length}`;
    }
    
    hideLoading() {
      this.loading.style.display = 'none';
    }
    
    showError() {
      this.loading.style.display = 'none';
      this.error.style.display = 'block';
    }
  }
  
  // Initialize photo galleries
  document.addEventListener('DOMContentLoaded', () => {
    const galleries = document.querySelectorAll('.photo-gallery');
    galleries.forEach(gallery => new PhotoGallery(gallery));
  });
  
  // Handle page navigation in Astro
  document.addEventListener('astro:page-load', () => {
    const galleries = document.querySelectorAll('.photo-gallery');
    galleries.forEach(gallery => new PhotoGallery(gallery));
  });
</script>
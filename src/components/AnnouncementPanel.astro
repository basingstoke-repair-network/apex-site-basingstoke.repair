import { getCollection } from 'astro:content';

// DEMO ONLY — simulates a visitor date between the October and (cancelled)
// November Hatch Warren sessions, so the November announcement renders for
// a management preview. Revert to `new Date()` before merging.
const now = new Date('2026-10-15T12:00:00');

const activeAnnouncements = (await getCollection('announcements'))
  .filter(({ data }) => {
    if (data.startDate && now < new Date(`${data.startDate}T00:00:00`)) return false;
    if (data.endDate && now > new Date(`${data.endDate}T23:59:59`)) return false;
    return true;
  })
  .sort((a, b) => a.data.order - b.data.order);
---

{activeAnnouncements.length > 0 && (
  <div class="announcement-panel">
    <div class="brn-container">
      {activeAnnouncements.map(({ data }) => <p>{data.message}</p>)}
    </div>
  </div>
)}

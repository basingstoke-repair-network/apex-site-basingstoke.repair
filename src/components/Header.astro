import { navItems } from '@data/navigation';
---

<header class="header-bg sticky top-0 z-50 shadow-md">
    <nav class="container mx-auto px-4 py-4">
        <div class="flex justify-between items-center">
            <!-- Logo -->
            <div class="flex items-center">
                <img src="/assets/images/logos/brn-logo.png" alt="Basingstoke Repair Network Logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='block';">
                <div class="text-2xl font-bold header-icon-color hidden">BRN</div>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex space-x-6">
                {navItems.map(item => (
                    <a href={item.href} class="nav-link hover:text-blue-600 transition">{item.label}</a>
                ))}
            </div>

            <!-- Mobile Menu Button -->
            <button id="mobile-menu-button" class="md:hidden header-icon-color focus:outline-none">
                <i class="fas fa-bars text-2xl"></i>
            </button>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4">
            {navItems.map(item => (
                <a href={item.href} class="block py-2 nav-link hover:text-blue-600 transition">{item.label}</a>
            ))}
        </div>
    </nav>
</header>

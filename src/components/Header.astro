---
import { Image } from 'astro:assets';
import BRNLogoLong from '../images/BRN-logo-long.png';
---

<header id="main-header" class="sticky top-0 z-10 flex items-center justify-between p-4 bg-brn-header border-b border-gray-300 transition-all duration-300 ease-in-out h-auto">
  <div class="logo max-w-xs md:max-w-md lg:max-w-xl">
    <Image src={BRNLogoLong} alt="BRN Logo" width={400} />
  </div>
  <nav class="hamburger-menu">
    <div class="icon cursor-pointer" id="menu-icon">&#9776;</div>
    <div class="menu hidden md:flex md:static md:flex-row md:items-center md:bg-transparent md:border-none md:p-0">
      <a href="#chineham" class="block p-2 text-brn-dark font-bold hover:text-brn-accent md:inline-block md:px-4">Chineham Repair Café</a>
      <a href="#hatch-warren" class="block p-2 text-brn-dark font-bold hover:text-brn-accent md:inline-block md:px-4">Hatch Warren Repair Café</a>
      <a href="#kings-furlong" class="block p-2 text-brn-dark font-bold hover:text-brn-accent md:inline-block md:px-4">Kings Furlong Repair Café</a>
      <a href="#other-local-repair-cafes" class="block p-2 text-brn-dark font-bold hover:text-brn-accent md:inline-block md:px-4">Other Local Repair Cafés</a>
      <a href="#get-involved" class="block p-2 text-brn-dark font-bold hover:text-brn-accent md:inline-block md:px-4">Get Involved</a>
    </div>
  </nav>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('main-header');
    const menuIcon = document.getElementById('menu-icon');
    const navMenu = document.querySelector('.hamburger-menu .menu');

    // Sticky header behavior
    window.addEventListener('scroll', () => {
      if (window.scrollY > 0) {
        header.classList.add('h-12'); // Tailwind's h-12 is 3rem
        header.classList.remove('h-auto');
      } else {
        header.classList.remove('h-12');
        header.classList.add('h-auto');
      }
    });

    // Hamburger menu toggle
    if (menuIcon && navMenu) {
      menuIcon.addEventListener('click', () => {
        navMenu.classList.toggle('active');
        navMenu.classList.toggle('hidden'); // Toggle Tailwind's hidden class
        navMenu.classList.toggle('flex'); // Toggle Tailwind's flex class
      });

      // Close menu when a link is clicked (for mobile)
      navMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          if (window.innerWidth < 768) { // Only close on mobile sizes
            navMenu.classList.remove('active');
            navMenu.classList.add('hidden');
            navMenu.classList.remove('flex');
          }
        });
      });
    }
  });
</script>
